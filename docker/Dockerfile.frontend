# =============================================================================
# HomeHub Frontend Dockerfile (Multi-stage build)
# Builds Web App & Admin Portal, then serves both via Nginx
# =============================================================================

# --- Stage 1: Build Web App ---
FROM node:20-alpine AS builder-web
WORKDIR /app
COPY frontend/web/package*.json ./
RUN npm install
COPY frontend/web ./
RUN npm run build

# --- Stage 2: Build Admin Portal ---
FROM node:20-alpine AS builder-admin
WORKDIR /app
COPY frontend/admin/package*.json ./
RUN npm install
COPY frontend/admin ./
RUN npm run build

# --- Stage 3: Production Nginx Server ---
FROM nginx:alpine
# Copy compiled static assets
COPY --from=builder-web /app/dist /usr/share/nginx/html/web
COPY --from=builder-admin /app/dist /usr/share/nginx/html/admin

# Copy custom Nginx configuration
COPY docker/nginx/conf.d/default.conf /etc/nginx/conf.d/default.conf

EXPOSE 80 8080
CMD ["nginx", "-g", "daemon off;"]
