# ==============================================================================
# HomeHub Platform - Root Environment Variables Example
# ==============================================================================

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=rootpassword

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Security
JWT_SECRET=supersecret_jwt_key_homehub_2026_dev_mode
JWT_EXPIRES_IN=7d

# Microservice Ports
PORT_GATEWAY=8000
PORT_AUTH=8001
PORT_UTILITY=8002
PORT_ASSET=8003
PORT_GROCERY=8004
PORT_FINANCE=8005
PORT_ACTIVITY=8006

# Google Gemini / Vision AI Key (OCR Receipt Intelligence)
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
VITE_GEMINI_API_KEY=

