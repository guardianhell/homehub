# =============================================================================
# HomeHub Production Environment Variables Template
# Copy this file to .env on your Ubuntu Home Server:
#   cp .env.production.example .env
# Then fill in the secure secrets below.
# =============================================================================

# --- Database & Redis Credentials ---
MYSQL_ROOT_PASSWORD=GantiDenganPasswordRootYangSangatKuat123!
MYSQL_USER=homehub_user
MYSQL_PASSWORD=GantiDenganPasswordDbUserYangKuat456!
REDIS_PASSWORD=GantiDenganPasswordRedisKuat789!

# --- Authentication & Webhook Security ---
# WAJIB: Minimal 32 karakter acak (misal di-generate via: openssl rand -hex 32)
JWT_SECRET=UbahDenganKarakterAcakMinimal32KarakterHarusSangatKuatDanRahasia!
PAYMENT_WEBHOOK_SECRET=UbahDenganKunciRahasiaWebhookPembayaranHMAC512!

# --- AI Vision / OCR (Opsional) ---
GEMINI_API_KEY=

# --- CORS & Network Origins ---
# Domain publik atau IP lokal yang diizinkan memanggil backend via browser
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:8080,https://homehub.domainanda.com,https://admin.domainanda.com

# --- Cloudflare Tunnel (Opsional namun Sangat Direkomendasikan untuk ISP Rumah) ---
# Dapatkan token dari Cloudflare Zero Trust Dashboard -> Networks -> Tunnels
CLOUDFLARE_TUNNEL_TOKEN=
